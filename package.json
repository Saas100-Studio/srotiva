{
  "name": "srotiva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --env-file-if-exists=.env.local --test src/test/*.test.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "worker:refresh": "node --env-file-if-exists=.env.local src/workers/refresh-worker.ts",
    "scheduler": "node --env-file-if-exists=.env.local src/workers/scheduler.ts",
    "audit:production": "bun scripts/audit-production.mjs",
    "validate-env": "node --env-file-if-exists=.env.local scripts/validate-env.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.27",
    "browserslist": "4.29.3",
    "js-yaml": "4.3.2"
  }
}
